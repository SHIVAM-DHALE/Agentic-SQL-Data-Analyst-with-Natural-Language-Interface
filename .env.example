GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_PORT=5432
API_BASE_URL=http://127.0.0.1:8000
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ACCESS_TOKEN_MINUTES=60
APP_ENV=development
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
API_TIMEOUT_SECONDS=20
API_QUERY_TIMEOUT_SECONDS=120
API_UPLOAD_TIMEOUT_SECONDS=120
MAX_UPLOAD_MB=20
MAX_UPLOAD_ROWS=100000
DB_STATEMENT_TIMEOUT_MS=15000
DEFAULT_ROW_LIMIT=500
PASSWORD_MIN_LENGTH=10
PASSWORD_RESET_TOKEN_MINUTES=30
# Optional independent pepper; if blank, JWT_SECRET_KEY is used.
PASSWORD_RESET_TOKEN_PEPPER=
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
PASSWORD_RESET_RATE_LIMIT_ATTEMPTS=5
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=900

# Local development prints the reset link in the backend console. Production
# must use smtp; console/disabled modes are rejected when APP_ENV=production.
EMAIL_DELIVERY_MODE=console
PASSWORD_RESET_BASE_URL=http://localhost:8501
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=false
SMTP_USE_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10
